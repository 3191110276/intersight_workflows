    "properties": {
      "atomic": {
        "is_atomic": false
      },
      "delete_workflow_instance": false,
      "description": "Starts a Cisco Repository firmware upgrade through the existing Cisco Intersight atomic for one server, one UCS-X chassis, or one IMM Domain (both FIs). The atomic owns target, image, relationship, readiness, duplicate-upgrade, input, and API validation; this wrapper does not repeat those checks. Server impact estimation is enabled, Domain starts immediately, and UCS-X XFM behavior is derived from validated equipped topology. The run succeeds with 202 as soon as Intersight returns and the atomic validates a concrete nonterminal upgrade resource; it does not poll or monitor completion. Only an immediate SUCCESSFUL create response returns 200. Reliable Intersight rejections preserve their 4xx details, while ambiguous results require inspection before retrying. Unified Edge eCMC upgrades are not exposed.",
      "display_name": "Cisco Intersight - Firmware upgrade",
      "runtime_user": {
        "override_target_runtime_user": false,
        "specify_on_workflow_start": false,
        "target_default": true
      },
      "target": {
        "target_type": "intersight.endpoint",
        "specify_on_workflow_start": true
      }
    },
