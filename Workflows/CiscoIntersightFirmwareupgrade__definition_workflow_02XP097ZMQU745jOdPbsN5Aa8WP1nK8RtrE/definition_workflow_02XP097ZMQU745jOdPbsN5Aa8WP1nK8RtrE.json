          {
            "unique_name": "definition_activity_02XP097ZMTQD46Pa3EMdJa1UOITmEjOATFA",
            "name": "Execute Python Script",
            "title": "Classify firmware upgrade atomic result",
            "type": "python3.script",
            "base_type": "activity",
            "properties": {
              "continue_on_failure": true,
              "description": "Validates the atomic activity and its four standard outputs, preserves the structured Result, accepts only a concrete start-only 202 contract or an immediate-completion 200 contract, and propagates genuine failures without resubmission.",
              "display_name": "Classify firmware upgrade atomic result",
              "skip_execution": false,
              "action_timeout": 180,
              "script": "import json\nimport re\nimport sys\n\nactivitySucceeded = str(sys.argv[1]).strip().lower() == \"true\"\natomicStatusCode = sys.argv[2].strip()\natomicStatusMessage = sys.argv[3].strip()\natomicErrorMessage = sys.argv[4].strip()\natomicResultRaw = sys.argv[5].strip()\nfirmwareVersion = sys.argv[6]\ndeviceOrganization = sys.argv[7]\nrequestedTargetName = sys.argv[8]\n\nresult = None\ntry:\n    candidate = json.loads(atomicResultRaw) if atomicResultRaw else None\n    if isinstance(candidate, dict):\n        result = candidate\nexcept Exception:\n    result = None\n\noutcome = \"failure\"\noutputStatusCode = \"502\"\noutputStatusMessage = \"Firmware upgrade atomic failed or returned an unusable contract\"\noutputErrorMessage = \"The firmware upgrade atomic did not return a usable submission contract. Inspect the atomic execution before retrying; this wrapper never resubmits.\"\n\nrequestAccepted = isinstance(result, dict) and result.get(\"requestAccepted\") is True\ncompleted = isinstance(result, dict) and result.get(\"completed\") is True\natomicState = str(result.get(\"status\") or \"\") if isinstance(result, dict) else \"\"\nidentityReady = isinstance(result, dict) and all(isinstance(result.get(key), str) and bool(result.get(key)) for key in (\"targetType\", \"targetMoid\", \"imageMoid\", \"createdMoid\"))\nif activitySucceeded and result is not None and requestAccepted and identityReady and completed and atomicState == \"completed\" and atomicStatusCode == \"200\":\n    outcome = \"completed\"\n    outputStatusCode = \"200\"\n    outputStatusMessage = atomicStatusMessage or \"Firmware upgrade completed immediately\"\n    outputErrorMessage = \"\"\nelif activitySucceeded and result is not None and requestAccepted and identityReady and not completed and atomicState == \"accepted\" and atomicStatusCode == \"202\":\n    outcome = \"accepted\"\n    outputStatusCode = \"202\"\n    outputStatusMessage = atomicStatusMessage or \"Firmware upgrade resource accepted; completion is not monitored\"\n    outputErrorMessage = \"\"\nelif result is not None:\n    outputStatusCode = atomicStatusCode if re.fullmatch(r\"[45][0-9][0-9]\", atomicStatusCode) is not None else \"502\"\n    outputStatusMessage = atomicStatusMessage or \"Firmware upgrade atomic reported failure\"\n    outputErrorMessage = atomicErrorMessage or atomicStatusMessage or \"The firmware upgrade atomic reported failure without an error message. Inspect its Result before retrying.\"\n\nif isinstance(result, dict):\n    result[\"deviceOrganization\"] = deviceOrganization\n    result[\"requestedTargetName\"] = requestedTargetName\n    result[\"requestedFirmwareVersion\"] = firmwareVersion\n    result[\"wrapperDisposition\"] = outcome\n    result[\"wrapperStatusCode\"] = outputStatusCode\n    result[\"atomicStatusCode\"] = atomicStatusCode or None\n    result[\"atomicActivitySucceeded\"] = activitySucceeded\n    result[\"atomicStatusMessage\"] = atomicStatusMessage or None\n    result[\"atomicErrorMessage\"] = atomicErrorMessage or None\n    result[\"resourceIdentifiersAvailable\"] = identityReady\n    if atomicErrorMessage:\n        result[\"atomicWarning\"] = atomicErrorMessage\n    outputResultJson = json.dumps(result, separators=(\",\", \":\"))\nelse:\n    outputResultJson = json.dumps({\"status\":\"failed\",\"requestAccepted\":False,\"atomicActivitySucceeded\":activitySucceeded,\"atomicStatusCode\":atomicStatusCode or None,\"atomicStatusMessage\":atomicStatusMessage or None,\"atomicErrorMessage\":atomicErrorMessage or None,\"deviceOrganization\":deviceOrganization,\"requestedTargetName\":requestedTargetName,\"requestedFirmwareVersion\":firmwareVersion,\"wrapperDisposition\":outcome,\"wrapperStatusCode\":outputStatusCode,\"atomicResultRaw\":atomicResultRaw or None,\"retryRequiresInspection\":True}, separators=(\",\", \":\"))\n\nhelperReady = outcome in (\"failure\", \"accepted\", \"completed\") and re.fullmatch(r\"[1-5][0-9][0-9]\", outputStatusCode) is not None and bool(outputStatusMessage and outputResultJson) and ((outcome == \"failure\" and bool(outputErrorMessage)) or (outcome in (\"accepted\", \"completed\") and outputErrorMessage == \"\"))\n",
              "script_arguments": [
                "$activity.definition_activity_02XP097ZMTNA06kBbKf5aOFVNtDChP5Up2C.output.succeeded$",
                "$activity.definition_activity_02XP097ZMTNA06kBbKf5aOFVNtDChP5Up2C.output.variable_workflow_02XOKCY8L72FB2SWbHrLitH1r33pOWfN8gq$",
                "$activity.definition_activity_02XP097ZMTNA06kBbKf5aOFVNtDChP5Up2C.output.variable_workflow_02XOKCY8L72FC5jxSq28zDsRALUWd6rcj9a$",
                "$activity.definition_activity_02XP097ZMTNA06kBbKf5aOFVNtDChP5Up2C.output.variable_workflow_02XOKCY8L72FD6jGidJVfqHludVA351HjQE$",
                "$activity.definition_activity_02XP097ZMTNA06kBbKf5aOFVNtDChP5Up2C.output.variable_workflow_02XOKCY8L72FE2gpBJF68reaRfWGtPqw6Tw$",
                "$workflow.definition_workflow_02XP097ZMQU745jOdPbsN5Aa8WP1nK8RtrE.input.variable_workflow_02XP097ZMRI481zkWRkl9UrUkQOTsHQ6oXA$",
                "$workflow.definition_workflow_02XP097ZMQU745jOdPbsN5Aa8WP1nK8RtrE.input.variable_workflow_02XP097ZMRAEG0RtLK75VPJkOePrwQ2Uvro$",
                "$workflow.definition_workflow_02XP097ZMQU745jOdPbsN5Aa8WP1nK8RtrE.input.variable_workflow_02XP097ZMRE9C0bi6pO5ISuM2ZGJ95EOtDY$"
              ],
